{
  "name": "geneasphere",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "check:encoding": "node scripts/check-encoding.mjs",
    "lint:encoding": "node scripts/check-encoding.mjs",
    "postinstall": "prisma generate --schema=packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "prisma": "^5.22.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "element-plus": "^2.14.2",
    "esbuild": "^0.28.1"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=2.5.4",
      "fast-xml-parser": ">=4.5.4",
      "multer": ">=2.2.0",
      "brace-expansion": "^5.0.8 || >=5.0.8",
      "js-yaml": ">=4.3.1",
      "fast-uri": ">=3.1.3",
      "immutable": ">=5.1.9",
      "postcss": ">=8.5.25",
      "uuid": ">=11.1.1"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@nestjs/cli"
      ]
    }
  },
  "packageManager": "pnpm@9.0.0"
}
